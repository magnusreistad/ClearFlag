#!/bin/sh
# Reject staged .env / .env.* files (any directory), except .env.example.
# Checked at commit time, so it catches files however they were staged
# (chained `git add && git commit`, `git commit -a`, IDE staging, ...).
# Deletions are allowed: removing a committed .env should never be blocked.
#
# Enabled per clone with: git config core.hooksPath .githooks
# pre-merge-commit is a symlink to this file, so merge commits are checked too.
blocked=$(git diff --cached --name-only --diff-filter=ACMR \
  | grep -E '(^|/)\.env(\.[^/]+)?$' \
  | grep -Ev '(^|/)\.env\.example$')

if [ -n "$blocked" ]; then
  echo "pre-commit: refusing to commit environment files:" >&2
  echo "$blocked" | sed 's/^/  /' >&2
  echo "Unstage with: git restore --staged <file>   (only .env.example may be committed)" >&2
  exit 1
fi
