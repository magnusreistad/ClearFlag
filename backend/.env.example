DATABASE_URL=postgresql://<user>:<password>@<host>/<dbname>?sslmode=require&channel_binding=require

# Investigation Agent LLM toggle (SCRUM-55). "mock" (default) never touches
# the network -- safe for CI and for local dev without a key. Only set this
# to "live" for a local demo; live mode refuses to run in CI regardless of
# this value (see app/investigation_agent/llm.py).
INVESTIGATION_AGENT_LLM_MODE=mock

# Required only when INVESTIGATION_AGENT_LLM_MODE=live.
ANTHROPIC_API_KEY=
# Optional overrides for live mode -- sensible defaults if left unset.
# INVESTIGATION_AGENT_LLM_MODEL=claude-sonnet-5-5
# INVESTIGATION_AGENT_LLM_TIMEOUT_SECONDS=30
# INVESTIGATION_AGENT_LLM_MAX_RETRIES=2
# Not set (and not passed to the model) by default -- newer model
# generations reject `temperature` outright as deprecated. Only set this for
# a model that still accepts it.
# INVESTIGATION_AGENT_LLM_TEMPERATURE=0
