DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>/<dbname>?sslmode=require&channel_binding=require

# Test suite database (SCRUM-67) -- the local docker-compose Postgres, never
# Neon: every test truncates every table, so tests/conftest.py refuses a
# database whose name doesn't contain "test". See README, "Running backend tests".
TEST_DATABASE_URL=postgresql+psycopg2://clearflag:clearflag@localhost:5433/clearflag_test

# Investigation Agent LLM toggle (SCRUM-55). "mock" (default) never touches
# the network -- safe for CI and for local dev without a key. Only set this
# to "live" for a local demo; live mode refuses to run in CI regardless of
# this value (see app/investigation_agent/llm.py).
INVESTIGATION_AGENT_LLM_MODE=mock

# Required only when INVESTIGATION_AGENT_LLM_MODE=live.
ANTHROPIC_API_KEY=
# Optional overrides for live mode -- sensible defaults if left unset.
# INVESTIGATION_AGENT_LLM_MODEL=claude-sonnet-5-5
# INVESTIGATION_AGENT_LLM_TIMEOUT_SECONDS=30
# INVESTIGATION_AGENT_LLM_MAX_RETRIES=2
# Not set (and not passed to the model) by default -- newer model
# generations reject `temperature` outright as deprecated. Only set this for
# a model that still accepts it.
# INVESTIGATION_AGENT_LLM_TEMPERATURE=0

# LangSmith tracing (SCRUM-53) -- dev observability only, off by default. Set
# LANGSMITH_TRACING=true and LANGSMITH_API_KEY for a local demo; never set in
# CI regardless (app/investigation_agent/tracing.py forces it off there, for
# every graph run made through app.investigation_agent.graph.invoke, even if
# these are set).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
# Optional overrides -- sensible defaults if left unset.
# LANGSMITH_PROJECT=clearflag-investigation-agent
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
